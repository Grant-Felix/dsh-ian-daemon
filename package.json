{
  "name": "@local/dsh-ian-daemon",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "systemd autostart, crash/safe-mode self-recovery and a manual 重启 button for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "supervisor.sh",
    "relaunch.sh",
    "units/*",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
