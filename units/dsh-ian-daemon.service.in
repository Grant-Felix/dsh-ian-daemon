# Generated by the @local/dsh-ian-daemon plugin — rewritten whenever it installs.
[Unit]
Description=DeepSeek Harness (web) — autostart and crash supervision
After=network-online.target
Wants=network-online.target
# If the supervisor itself keeps dying, systemd gives up and the safe-mode unit
# takes over (it boots the pristine safe profile and reports the incident).
StartLimitIntervalSec=90
StartLimitBurst=5
OnFailure=@@SAFE_UNIT@@

[Service]
Type=simple
ExecStart=/bin/bash @@HOME_DIR@@/bin/supervisor.sh
Restart=on-failure
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStopSec=30
KillMode=control-group
Slice=app.slice
SyslogIdentifier=dsh-ian-daemon
StandardOutput=journal
StandardError=journal
Environment=DSH_HOME=@@DSH_HOME@@
Environment=PATH=@@PATH@@

[Install]
WantedBy=default.target
