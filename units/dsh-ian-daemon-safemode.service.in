# Generated by the @local/dsh-ian-daemon plugin — rewritten whenever it installs.
[Unit]
Description=DeepSeek Harness safe mode (recovery fallback)
After=@@MAIN_UNIT@@
# Started by OnFailure= from @@MAIN_UNIT@@ when that unit cannot stay up.
# It boots the pristine safe profile, writes an incident report and notifies
# the desktop. Not enabled at boot: the main unit owns autostart.

[Service]
Type=simple
ExecStart=/bin/bash @@HOME_DIR@@/bin/supervisor.sh --force-safe
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillMode=control-group
Slice=app.slice
SyslogIdentifier=dsh-ian-daemon-safemode
StandardOutput=journal
StandardError=journal
Environment=DSH_HOME=@@DSH_HOME@@
Environment=PATH=@@PATH@@
